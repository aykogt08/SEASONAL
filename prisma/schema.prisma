datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum Category {
  FRUIT
  VEGETABLE
  SEAFOOD
  OTHER
}

model User {
  id        String      @id @default(cuid())
  name      String      @unique
  avatar    String      @default("🌸")
  password  String?     // Optional password/PIN protection
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  checks       FoodCheck[]
  foods        FoodItem[]
  hiddenFoods  UserHiddenFood[]
}

model FoodItem {
  id        String      @id @default(cuid())
  userId    String?     // null for standard preset items, user ID for custom items
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameEn    String      // English label (e.g., WHITE PEACH)
  nameJa    String      // Japanese sub label (e.g., 白桃)
  category  Category    @default(FRUIT)
  season    Season      // SPRING, SUMMER, AUTUMN, WINTER
  iconUrl   String      @db.Text // Custom image or preset SVG/data URI
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  checks    FoodCheck[]

  @@index([userId])
}

model UserHiddenFood {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItemId String
  createdAt  DateTime @default(now())

  @@unique([userId, foodItemId])
  @@index([userId])
}

model FoodCheck {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year       Int       // Year (e.g., 2026)
  foodItemId String
  foodItem   FoodItem  @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  isEaten    Boolean   @default(false)
  eatenAt    DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, year, foodItemId])
  @@index([userId, year])
  @@index([year])
}
